{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-index.mjs\" regras" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-index.mjs\" projeto" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\" hook" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-quality.mjs\" base" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\" hook" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/suggest-skill.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\" hook" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-doc-staging.mjs\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/require-rtk.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lock.mjs\" hook" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/alerta-contexto.mjs\"" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-quality.mjs\"", "timeout": 120 }
        ]
      }
    ]
  }
}
